# Variáveis de ambiente do frontend (spec D-10). Copie para .env.local para
# sobrescrever localmente; .env.development já liga os mocks no dev.

# Endereço do backend (usado pelo cliente HTTP de src/api/ a partir da FEAT-01).
VITE_API_URL=http://localhost:3000

# 'true' liga o MSW (mocks de rede) no dev. Qualquer outro valor desliga.
VITE_USE_MOCKS=true
